# ============================================
# 环境变量模板（复制本文件为 .env 后填写真实值）
#   cp .env.example .env
# 注意：真实 .env 已被 .gitignore 忽略，不会提交到 GitHub
# ============================================

# 服务端口
SERVER_PORT=3000

# 数据库配置（用于 Docker Compose 与后端连接）
DB_PORT=3306
DB_USER=root
DB_PASSWORD=请修改为你的强密码
DB_NAME=link

# JWT 密钥（本地开发使用）
# JWT_SECRET=请修改为随机长字符串密钥
# JWT_EXPIRES_IN=7d
